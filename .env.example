# Supabase Auth (use the project URL and publishable key; never put a secret key here)
NEXT_PUBLIC_SUPABASE_URL=https://ebrdqwsdidqbgaagprvg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Prisma database connection for app data (not Supabase Auth credentials)
DATABASE_URL=postgresql://postgres:your-database-password@db.ebrdqwsdidqbgaagprvg.supabase.co:5432/postgres

# AI providers
MISTRAL_API_KEY=your_mistral_api_key
GEMINI_API_KEY=your_gemini_api_key

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_CLIENT_ID=
